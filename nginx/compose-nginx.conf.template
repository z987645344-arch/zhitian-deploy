worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

# 本文件是nginx官方镜像的配置模板，不是可直接加载的nginx.conf。
# 只有ZHITIAN_前缀的变量会被入口脚本的envsubst替换（由NGINX_ENVSUBST_FILTER限定）；
# $host、$remote_addr、$proxy_add_x_forwarded_for、$scheme、$request_uri、$force_https
# 以及下面set出来的上游变量必须原样交给nginx。新增需要注入的变量时一律沿用
# ZHITIAN_前缀：入口脚本的替换清单来自环境变量名，一旦有环境变量与这些nginx变量
# 同名，值会被静默改写，而nginx仍然正常加载、不报任何错。
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    sendfile on;
    keepalive_timeout 65;

    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;

    # 两个443站点共用同一套TLS参数与同一张证书。证书按固定路径挂进容器，
    # 宿主机上的真实位置由Compose的ZHITIAN_TLS_*_PATH决定，与容器内路径无关。
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1h;

    # ================================================================
    # 容器内8080（宿主机80）
    #
    # ZHITIAN_FORCE_HTTPS=on（生产必须）：除容器健康检查外一律301到HTTPS。
    # ZHITIAN_FORCE_HTTPS=off（仅本机回环部署）：保留完整HTTP路由，
    #   http://localhost 到管理后台、http://localhost/customer/ 到客户端、
    #   http://localhost/api 到后端，本机既有验收流程原样可用。
    # 下面两个443块不受该开关影响，两种取值下行为完全一致。
    # ================================================================
    server {
        listen 8080;
        server_name _;

        client_max_body_size 25m;
        resolver 127.0.0.11 valid=30s ipv6=off;

        # 本server监听容器内8080、由宿主机80映射进来。若让nginx生成绝对
        # 重定向，Location会带上内部端口（http://host:8080/...），而该端口
        # 对外并不存在，浏览器跟随即连接被拒。关掉后统一返回相对Location。
        absolute_redirect off;

        # 值由Compose注入。$force_https本身是nginx变量、刻意不带ZHITIAN_前缀，
        # 因此不会被envsubst触碰；只有等号右边的${ZHITIAN_FORCE_HTTPS}会被替换。
        set $force_https ${ZHITIAN_FORCE_HTTPS};

        # 下面各location的守卫刻意写成 != off 而不是 = on：让笔误倒向生产行为。
        # 若写 = on，则ON、On、true或末尾多个空格都会落到else分支，在生产上
        # 等于把企业管理后台重新摆回公网IP的明文HTTP根路径——正是拆分双子域名
        # 要消除的暴露，一个大小写错误即可全部作废。
        # 改成 != off 后：生产侧任何笔误仍按生产行为运行；本机侧笔误则会立刻
        # 跳HTTPS、当场暴露，改掉即可。失败方向指向安全，而不是指向方便。

        # Compose健康检查在容器内请求http://127.0.0.1:8080/api/ready。
        # 这里刻意不加跳转守卫：两种模式下健康检查都必须直通，否则反代永远
        # 不会healthy。精确匹配优先于下面的/api/前缀匹配。
        location = /api/ready {
            set $api_upstream zhitian-api:8000;
            rewrite ^/api(/.*)$ $1 break;
            proxy_pass http://$api_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Connection "";
            proxy_connect_timeout 10s;
        }

        location /api/ {
            if ($force_https != off) { return 301 https://$host$request_uri; }
            set $api_upstream zhitian-api:8000;
            rewrite ^/api(/.*)$ $1 break;
            proxy_pass http://$api_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";
            proxy_connect_timeout 10s;
            proxy_send_timeout 180s;
            proxy_read_timeout 180s;
            # /chat/stream是真流式SSE，一旦缓冲前端就收不到增量输出，不能删。
            proxy_buffering off;
        }

        # customer网页客户端。裸路径没有index.html，入口是login.html，
        # 显式重定向而不是让上游退化成目录请求。
        location = /customer {
            if ($force_https != off) { return 301 https://$host$request_uri; }
            return 301 /customer/login.html;
        }

        location = /customer/ {
            if ($force_https != off) { return 301 https://$host$request_uri; }
            return 301 /customer/login.html;
        }

        # 与/api/同一手法：剥掉前缀再转发，镜像因此不感知对外路径。
        # 页面内资源用的是相对路径（./css、./js、./config.js），从
        # /customer/login.html解析出的仍在/customer/下，会一并被剥掉前缀；
        # 而config.js里的apiBaseUrl是绝对路径/api，不受本前缀影响，仍命中
        # 上面的/api/规则直达后端。
        location /customer/ {
            if ($force_https != off) { return 301 https://$host$request_uri; }
            set $web_upstream zhitian-web:8080;
            rewrite ^/customer(/.*)$ $1 break;
            proxy_pass http://$web_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";
        }

        location / {
            if ($force_https != off) { return 301 https://$host$request_uri; }
            set $admin_upstream zhitian-admin:8080;
            proxy_pass http://$admin_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";
        }
    }

    # ================================================================
    # 容器内8443（宿主机443）：customer网页客户端
    # 本块写在前面，因此同时是8443的默认server：用IP或未知Host直连时落到
    # 客户端站点，而不是权限最高的企业管理后台。
    # ================================================================
    server {
        listen 8443 ssl;
        server_name ${ZHITIAN_CUSTOMER_SERVER_NAME};

        ssl_certificate /etc/nginx/tls/origin.pem;
        ssl_certificate_key /etc/nginx/tls/origin.key;

        client_max_body_size 25m;
        resolver 127.0.0.11 valid=30s ipv6=off;
        absolute_redirect off;

        # 剥掉/api前缀再转发，镜像因此不感知对外路径。
        location /api/ {
            set $api_upstream zhitian-api:8000;
            rewrite ^/api(/.*)$ $1 break;
            proxy_pass http://$api_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";
            proxy_connect_timeout 10s;
            proxy_send_timeout 180s;
            proxy_read_timeout 180s;
            # /chat/stream是真流式SSE，一旦缓冲前端就收不到增量输出，不能删。
            proxy_buffering off;
        }

        # 客户端站点没有index.html，入口是login.html；显式重定向而不是
        # 让上游退化成目录请求。
        location = / {
            return 301 /login.html;
        }

        # 站点已经在自己域名的根路径下，不再剥任何前缀。
        location / {
            set $web_upstream zhitian-web:8080;
            proxy_pass http://$web_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";
        }
    }

    # ================================================================
    # 容器内8443（宿主机443）：企业管理后台
    # 与客户端分成两个主机名的目的是让两个前端不同源：客户端一旦出现XSS，
    # 也读不到管理后台localStorage里的developer/reviewer令牌。
    # ================================================================
    server {
        listen 8443 ssl;
        server_name ${ZHITIAN_ADMIN_SERVER_NAME};

        ssl_certificate /etc/nginx/tls/origin.pem;
        ssl_certificate_key /etc/nginx/tls/origin.key;

        client_max_body_size 25m;
        resolver 127.0.0.11 valid=30s ipv6=off;
        absolute_redirect off;

        location /api/ {
            set $api_upstream zhitian-api:8000;
            rewrite ^/api(/.*)$ $1 break;
            proxy_pass http://$api_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";
            proxy_connect_timeout 10s;
            proxy_send_timeout 180s;
            proxy_read_timeout 180s;
            proxy_buffering off;
        }

        location / {
            set $admin_upstream zhitian-admin:8080;
            proxy_pass http://$admin_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";
        }
    }
}
