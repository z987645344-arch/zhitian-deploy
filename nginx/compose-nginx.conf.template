worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

# 本文件是nginx官方镜像的配置模板，不是可直接加载的nginx.conf。
# 只有ZHITIAN_前缀的变量会被入口脚本的envsubst替换（由NGINX_ENVSUBST_FILTER限定）；
# $host、$remote_addr、$proxy_add_x_forwarded_for、$scheme、$request_uri、$force_https
# 以及下面set出来的上游变量必须原样交给nginx。新增需要注入的变量时一律沿用
# ZHITIAN_前缀：入口脚本的替换清单来自环境变量名，一旦有环境变量与这些nginx变量
# 同名，值会被静默改写，而nginx仍然正常加载、不报任何错。
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    sendfile on;
    keepalive_timeout 65;

    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;

    # 两个443站点共用同一套TLS参数与同一张证书。证书按固定路径挂进容器，
    # 宿主机上的真实位置由Compose的ZHITIAN_TLS_*_PATH决定，与容器内路径无关。
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1h;

    # 8080的客户端/default块同时承接本机既有入口。只有两个必填主机名配置
    # 为受支持的localhost/admin.localhost组合，且请求Host也是本机名时，
    # 根路径才继续指向管理后台；真实主机名配置下伪造Host: localhost仍会
    # 倒向客户端。本机/customer/始终显式走客户端，三条既有流程不变。
    map "${ZHITIAN_CUSTOMER_SERVER_NAME}|${ZHITIAN_ADMIN_SERVER_NAME}|$host" $default_frontend_upstream {
        default zhitian-web:8080;
        "localhost|admin.localhost|localhost" zhitian-admin:8080;
        "localhost|admin.localhost|127.0.0.1" zhitian-admin:8080;
    }
    map "${ZHITIAN_CUSTOMER_SERVER_NAME}|${ZHITIAN_ADMIN_SERVER_NAME}|$host" $root_is_customer {
        default 1;
        "localhost|admin.localhost|localhost" 0;
        "localhost|admin.localhost|127.0.0.1" 0;
    }

    # ================================================================
    # 容器内8080（宿主机HTTP端口）：customer网页客户端与未知Host
    # 本块写在前面，因此同时是8080的默认server；未知Host倒向客户端，
    # 不依赖仓库外的上游代理替本仓库保护管理后台。
    #
    # ZHITIAN_FORCE_HTTPS只控制HTTP是否跳转，不参与主机名分流：上游终止
    # TLS时可取off并保留双主机名路由，独立部署需跳HTTPS时可取on。
    # ================================================================
    server {
        listen 8080;
        # 主机名是必填项；空值刻意渲染为非法配置并使nginx拒绝启动，避免
        # 配置错误被静默接受后退化成意外的默认站点。
        server_name ${ZHITIAN_CUSTOMER_SERVER_NAME};

        client_max_body_size 25m;
        resolver 127.0.0.11 valid=30s ipv6=off;
        absolute_redirect off;
        set $force_https ${ZHITIAN_FORCE_HTTPS};

        # Compose健康检查使用Host 127.0.0.1；未知Host也会落入本default块。
        # 本location刻意不加HTTPS跳转，确保任何Host下/api/ready都可达。
        location = /api/ready {
            set $api_upstream zhitian-api:8000;
            rewrite ^/api(/.*)$ $1 break;
            proxy_pass http://$api_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Connection "";
            proxy_connect_timeout 10s;
        }

        location /api/ {
            if ($force_https != off) { return 301 https://$host$request_uri; }
            set $api_upstream zhitian-api:8000;
            rewrite ^/api(/.*)$ $1 break;
            proxy_pass http://$api_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";
            proxy_connect_timeout 10s;
            proxy_send_timeout 180s;
            proxy_read_timeout 180s;
            proxy_buffering off;
        }

        # 兼容本机/customer/前缀入口；真实客户端主机名直接使用根路径。
        location = /customer {
            if ($force_https != off) { return 301 https://$host$request_uri; }
            return 301 /customer/login.html;
        }

        location = /customer/ {
            if ($force_https != off) { return 301 https://$host$request_uri; }
            return 301 /customer/login.html;
        }

        location /customer/ {
            if ($force_https != off) { return 301 https://$host$request_uri; }
            set $web_upstream zhitian-web:8080;
            rewrite ^/customer(/.*)$ $1 break;
            proxy_pass http://$web_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";
        }

        # 客户端站点没有index.html；真实客户端主机名与未知Host的根路径
        # 重定向到login.html。本机localhost根路径则继续代理到管理后台。
        location = / {
            if ($force_https != off) { return 301 https://$host$request_uri; }
            if ($root_is_customer = 1) { return 301 /login.html; }
            set $admin_upstream zhitian-admin:8080;
            proxy_pass http://$admin_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";
        }

        location / {
            if ($force_https != off) { return 301 https://$host$request_uri; }
            proxy_pass http://$default_frontend_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";
        }
    }

    # ================================================================
    # 容器内8080（宿主机HTTP端口）：企业管理后台
    # 与客户端分成两个主机名，保持与8443相同的站点隔离结构。
    # ================================================================
    server {
        listen 8080;
        server_name ${ZHITIAN_ADMIN_SERVER_NAME};

        client_max_body_size 25m;
        resolver 127.0.0.11 valid=30s ipv6=off;
        absolute_redirect off;
        set $force_https ${ZHITIAN_FORCE_HTTPS};

        # 已匹配管理主机名时也必须让健康路径直通；否则server选择发生在
        # location匹配之前，default块里的开口无法覆盖本块。
        location = /api/ready {
            set $api_upstream zhitian-api:8000;
            rewrite ^/api(/.*)$ $1 break;
            proxy_pass http://$api_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Connection "";
            proxy_connect_timeout 10s;
        }

        location /api/ {
            if ($force_https != off) { return 301 https://$host$request_uri; }
            set $api_upstream zhitian-api:8000;
            rewrite ^/api(/.*)$ $1 break;
            proxy_pass http://$api_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";
            proxy_connect_timeout 10s;
            proxy_send_timeout 180s;
            proxy_read_timeout 180s;
            proxy_buffering off;
        }

        location / {
            if ($force_https != off) { return 301 https://$host$request_uri; }
            set $admin_upstream zhitian-admin:8080;
            proxy_pass http://$admin_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";
        }
    }

    # ================================================================
    # 容器内8443（宿主机443）：customer网页客户端
    # 本块写在前面，因此同时是8443的默认server：用IP或未知Host直连时落到
    # 客户端站点，而不是权限最高的企业管理后台。
    # ================================================================
    server {
        listen 8443 ssl;
        server_name ${ZHITIAN_CUSTOMER_SERVER_NAME};

        ssl_certificate /etc/nginx/tls/origin.pem;
        ssl_certificate_key /etc/nginx/tls/origin.key;

        client_max_body_size 25m;
        resolver 127.0.0.11 valid=30s ipv6=off;
        absolute_redirect off;

        # 剥掉/api前缀再转发，镜像因此不感知对外路径。
        location /api/ {
            set $api_upstream zhitian-api:8000;
            rewrite ^/api(/.*)$ $1 break;
            proxy_pass http://$api_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";
            proxy_connect_timeout 10s;
            proxy_send_timeout 180s;
            proxy_read_timeout 180s;
            # /chat/stream是真流式SSE，一旦缓冲前端就收不到增量输出，不能删。
            proxy_buffering off;
        }

        # 客户端站点没有index.html，入口是login.html；显式重定向而不是
        # 让上游退化成目录请求。
        location = / {
            return 301 /login.html;
        }

        # 站点已经在自己域名的根路径下，不再剥任何前缀。
        location / {
            set $web_upstream zhitian-web:8080;
            proxy_pass http://$web_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";
        }
    }

    # ================================================================
    # 容器内8443（宿主机443）：企业管理后台
    # 与客户端分成两个主机名的目的是让两个前端不同源：客户端一旦出现XSS，
    # 也读不到管理后台localStorage里的developer/reviewer令牌。
    # ================================================================
    server {
        listen 8443 ssl;
        server_name ${ZHITIAN_ADMIN_SERVER_NAME};

        ssl_certificate /etc/nginx/tls/origin.pem;
        ssl_certificate_key /etc/nginx/tls/origin.key;

        client_max_body_size 25m;
        resolver 127.0.0.11 valid=30s ipv6=off;
        absolute_redirect off;

        location /api/ {
            set $api_upstream zhitian-api:8000;
            rewrite ^/api(/.*)$ $1 break;
            proxy_pass http://$api_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";
            proxy_connect_timeout 10s;
            proxy_send_timeout 180s;
            proxy_read_timeout 180s;
            proxy_buffering off;
        }

        location / {
            set $admin_upstream zhitian-admin:8080;
            proxy_pass http://$admin_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";
        }
    }
}
